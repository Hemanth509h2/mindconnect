# Neon Postgres connection string (Neon console → Connect). The same database is
# used when running locally and by the live site on Vercel.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
# Long random string used to sign login tokens: `openssl rand -base64 32`
AUTH_SECRET=""
# Frontends allowed to call the API from the browser (comma-separated)
ALLOWED_ORIGINS="http://localhost:3200"
