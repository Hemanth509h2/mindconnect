# Neon Postgres, connecting as the `mindconnect` role (see prisma/neon-setup.sql).
# `schema=` picks MindConnect's schema: mindconnect_dev here, mindconnect on Vercel.
# HOST: the pooled host of STAAD's app database (DATABASE_URL in STAAD's backend/.env).
DATABASE_URL="postgresql://mindconnect:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require&connect_timeout=30&pool_timeout=30&schema=mindconnect_dev"
# Same URL with schema=mindconnect. Used only by `npm run db:push:prod`.
PRODUCTION_DATABASE_URL="postgresql://mindconnect:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require&connect_timeout=30&pool_timeout=30&schema=mindconnect"
# Long random string used to sign login tokens: `openssl rand -base64 32`
AUTH_SECRET=""
# Frontends allowed to call the API from the browser (comma-separated)
ALLOWED_ORIGINS="http://localhost:3200"
